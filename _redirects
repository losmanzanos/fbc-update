# Full Bloom Counseling — Netlify Redirect Rules
# True 301 redirects for WordPress → Static Site migration
# These replace the need for Cloudflare page rules

# ── www → non-www canonical redirect ────────────────────────────────────────
https://www.fullbloomcounseling.com/* https://fullbloomcounseling.com/:splat 301!

# ── WordPress admin/system URLs ──────────────────────────────────────────────
/wp-admin/*          /          301
/wp-login.php        /          301
/wp-content/*        /          301
/xmlrpc.php          /          301
/feed/               /blog/     301
/feed                /blog/     301
/rss/                /blog/     301
/atom/               /blog/     301

# ── WordPress archive patterns ───────────────────────────────────────────────
/category/*          /blog/     301
/tag/*               /blog/     301
/author/*            /therapists/ 301
/page/*              /          301
/:year/:month/:day/:slug/  /blog/:slug/  301

